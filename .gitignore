.env
.env.*
!.env.example

# Python virtual environments
.venv/
.venv-tts/
venv/

# Python cache and compiled files
__pycache__/
*.py[cod]

# Local Kokoro model weights
/models/kokoro/*.onnx
/models/kokoro/*.bin

# Generated audio and temporary artifacts
/kokoro_test.wav
/test_audio_tail.pyclear
/threshold)
/audio/kokoro/tts.py.bak

# Local cleanup backups
/cleanup_quarantine/